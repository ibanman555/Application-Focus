{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Application Focus",
  "Description": "Focus a window of an application that's already running. Never launches the target app.",
  "Author": "Koop",
  "Version": "1.0.3.0",
  "UUID": "com.koop.appfocus",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "Category": "Application Focus",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "com.koop.appfocus.focus",
      "Name": "Focus Existing App",
      "Tooltip": "Bring an already-running application window to the foreground (never launches it).",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html",
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    }
  ],
  "CategoryIcon": "imgs/category"
}
